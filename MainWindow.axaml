<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="300"
        x:Class="AM_RPC.MainWindow"
        Title="Apple Music RPC"
        Width="520" Height="300"
        MinWidth="520" MinHeight="300"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico">
    <DockPanel Margin="24">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <TextBlock Text="Apple Music RPC" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Settings" Click="OnSettingsClicked" Padding="14,8" CornerRadius="8"/>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" FontSize="12" Foreground="#8A8F98" Margin="0,12,0,0"/>

        <Grid ColumnDefinitions="Auto,*" Margin="0,20,0,0">
            <Border Grid.Column="0" Width="172" Height="172" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <Border x:Name="ArtworkPlaceholder" Background="#22252B">
                        <TextBlock Text="&#x266A;" FontSize="64" Foreground="#3A4048"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image x:Name="ArtworkImage" IsVisible="False" Stretch="UniformToFill"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="20,4,0,0" Spacing="8">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="Nothing playing"/>
                <TextBlock x:Name="ArtistText" FontSize="14" Foreground="#C9CDD3"/>
                <TextBlock x:Name="AlbumText" FontSize="13" Foreground="#8A8F98"/>

                <StackPanel Spacing="4" Margin="0,10,0,0">
                    <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="1" Value="0"/>
                    <TextBlock x:Name="TimeText" FontSize="12" Foreground="#8A8F98"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>